.L BDT.h
BDT l
l.Training(l.cut, l.DVCS, l.Pi0, l.Vars)
l.Training_vars(l.Data, l.DVCS, l.Pi0, l.cut);
l.Add_BDT_var_Formula(l.cut, l.Data, l.TData, l.Vars);
l.Add_BDT_var_Formula(l.cut, l.DVCS, l.TDVCS, l.Vars);
l.Add_BDT_var_Formula(l.cut, l.Pi0, l.TPi0, l.Vars);
l.Explore(l.TData, l.TDVCS, l.cut)
l.Estimate_Pi0(l.TData, TCut("bestCandidateFlag==1"), l.cut + TCut(Form("_strip_Nuc_BDT>%f ",-0.4 + 0.8*10/20)))
l.Add_BDT_var2(l.TData);
l.Best(10, l.TData, l.TDVCS, l.cut)
l.Stack(l.cut, "N_Ph_in==1")

l.Is_Pi0()

l.Training_on_bins(l.Folder + l.TData, 60000);
l.To_bin_or_not_to_bin(l.Data, 60000);
l.P_vs_NP(l.Data, 60000);

l.Maxime(l.cut);
l.Add_BDT_var_float(l.cut, l.Pi0, l.TPi0);


